# Use a unique password with at least 10 characters.
ADMIN_PASSWORD=replace-this-with-a-long-private-password

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Generate once with: npm run push:keys
# Keep the private key secret and reuse the same pair across deployments.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hi@0mar.lol

DATA_DIR=/app/data
# ملاحظة: DATA_DIR يُستخدم داخل حاوية Docker فقط.
# محلياً يتجاهله الكود ويستخدم مجلد data/ داخل المشروع.
